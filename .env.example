# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=tradcribe_db

# Configuración de Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Configuración de DeepL API (Ultra-rápido)
DEEPL_API_KEY=

# Configuración de API de Traducción Web Externa (Opcional)
WEB_TRANSLATOR_URL=
WEB_TRANSLATOR_KEY=

# Configuración del Pipeline de Agentes
AGENT_MAX_CHUNK_SIZE=3000
AGENT_CRITIC_ENABLED=true
AGENT_TEMPERATURE=0.2
